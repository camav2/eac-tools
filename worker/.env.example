# Tend worker — environment for the Mac mini.
# Copy to worker/.env and fill in. Same values as Vercel → Settings →
# Environment Variables. worker/.env is git-ignored.

# ── Required ──────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
ANTHROPIC_API_KEY=

# ── Tools (only what your teammates are granted) ──────────────────────────────
CIRCLE_API_TOKEN=
CIRCLE_COMMUNITY_ID=
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_CUSTOMERS_BASE_ID=
AIRTABLE_CUSTOMERS_TABLE_ID=
WEBFLOW_API_TOKEN=
BREVO_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────────
# Which admin scheduled runs act as. Defaults to whoever has Gmail connected.
TEND_ADMIN_EMAIL=
# Shown on the dashboard. Defaults to the machine's hostname.
TEND_WORKER_ID=mac-mini
# OpenRouter, only if a teammate uses it.
OPENROUTER_API_KEY=
