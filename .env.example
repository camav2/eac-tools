# Every variable the code in api/ actually reads.
# Regenerate the list with:  grep -rhoE "process\.env\.[A-Z0-9_]+" api/ | sed 's/process\.env\.//' | sort -u

# ── Airtable ──────────────────────────────────────────────────────────────────
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
AIRTABLE_UNBLOCKER_TABLE_ID=
AIRTABLE_ISBN_WIZARD_TABLE_ID=
AIRTABLE_QNA_TABLE_ID=
AIRTABLE_ATTENDING_TABLE_ID=

# Member email lookup for the Q&A invitation. A different base to the one
# above, so AIRTABLE_API_KEY must be scoped to BOTH or the lookup returns
# nothing and every address has to be typed in by hand.
AIRTABLE_CUSTOMERS_BASE_ID=
AIRTABLE_CUSTOMERS_TABLE_ID=

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=
ACCESS_CONFIG_JSON=

# ── Supabase (audio storage, Gmail tokens, mail merge jobs) ───────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Gmail (mail merge, and the Q&A invitation) ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Webflow ───────────────────────────────────────────────────────────────────
WEBFLOW_API_TOKEN=

# ── Circle ────────────────────────────────────────────────────────────────────
CIRCLE_API_TOKEN=
CIRCLE_COMMUNITY_ID=
CIRCLE_ADMIN_GROUP=
CIRCLE_ADMIN_V2_TOKEN=
CIRCLE_ADMIN_V2_URL=

# ── Brevo ─────────────────────────────────────────────────────────────────────
BREVO_API_KEY=

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# ── Webhooks and crons ────────────────────────────────────────────────────────
COWRITING_WEBHOOK_SECRET=
CRON_SECRET=

# ── Tend (both optional) ──────────────────────────────────────────────────────
# Scheduled runs act as the admin who has Gmail connected on /mail-merge, so
# nothing is needed here for a single-admin install. Set this only to pick one
# admin when several have connected. Manual runs use the logged-in admin.
TEND_ADMIN_EMAIL=
# OpenRouter appears in the Brain picker only once this is set. Leave blank
# to offer Claude alone (ANTHROPIC_API_KEY above).
OPENROUTER_API_KEY=

# ── Attending: Sign In with LinkedIn (OIDC) + optional one-click posting ──────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# 'true' requests w_member_social and turns on one-click posting
LINKEDIN_ENABLE_POSTING=
# YYYYMM, defaults to 202508 in code. Bump when LinkedIn returns 426.
LINKEDIN_API_VERSION=
# Both skipped cleanly while unset
BREVO_ATTENDING_LIST_ID=
BREVO_ATTENDING_TEMPLATE_ID=
