# Every variable the code in api/ actually reads.
# Regenerate the list with:  grep -rhoE "process\.env\.[A-Z0-9_]+" api/ | sed 's/process\.env\.//' | sort -u

# ── Airtable ──────────────────────────────────────────────────────────────────
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
AIRTABLE_UNBLOCKER_TABLE_ID=
AIRTABLE_ISBN_WIZARD_TABLE_ID=
AIRTABLE_QNA_TABLE_ID=

# Member email lookup for the Q&A invitation. A different base to the one
# above, so AIRTABLE_API_KEY must be scoped to BOTH or the lookup returns
# nothing and every address has to be typed in by hand.
AIRTABLE_CUSTOMERS_BASE_ID=
AIRTABLE_CUSTOMERS_TABLE_ID=

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=
ACCESS_CONFIG_JSON=

# ── Supabase (audio storage, Gmail tokens, mail merge jobs) ───────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Gmail (mail merge, and the Q&A invitation) ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Webflow ───────────────────────────────────────────────────────────────────
WEBFLOW_API_TOKEN=

# ── Circle ────────────────────────────────────────────────────────────────────
CIRCLE_API_TOKEN=
CIRCLE_COMMUNITY_ID=
CIRCLE_ADMIN_GROUP=
CIRCLE_ADMIN_V2_TOKEN=
CIRCLE_ADMIN_V2_URL=

# ── Brevo ─────────────────────────────────────────────────────────────────────
BREVO_API_KEY=

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# ── Webhooks and crons ────────────────────────────────────────────────────────
COWRITING_WEBHOOK_SECRET=
CRON_SECRET=
